# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
public/Staffbalance/
public/hr-policy/
public/Staff-Balance---MPV/
public/ApplicationForm-V2/
Public/teams-time-bd/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example as the safe template)
.env*
!.env.example

# local agent / IDE secrets (never commit)
.codex/

# supabase CLI local temp
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
